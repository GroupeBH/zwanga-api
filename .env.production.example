# Production runtime variables imported to AWS SSM Parameter Store.
# Copy this file locally to .env.production and fill production values.
# Do not commit .env.production.
#
# Terraform generates DATABASE_URL, REDIS_URL, REDIS_TLS, JWT_SECRET,
# JWT_REFRESH_SECRET, NODE_ENV, HOST, PORT, API_PREFIX, TYPEORM_SYNCHRONIZE
# and AWS_REGION separately. Do not set AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY
# for ECS; the task role provides AWS permissions.

# Public URLs / CORS
CORS_ORIGINS=https://zwanga-app.com,https://www.zwanga-app.com
FRONTEND_URL=https://zwanga-app.com
PUBLIC_API_BASE_URL=https://api.zwanga-app.com
TRACKING_PUBLIC_BASE_URL=https://zwanga-app.com/trips
ZWANGA_PUBLIC_WEB_URL=https://zwanga-app.com

# Logging is managed by Terraform for ECS production:
# LOG_LEVEL=warn
# GPS_LOG_SAMPLE_RATE=0.01
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# Auth token lifetimes
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=21d

# Uploads / AWS application services
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=5242880
# Managed by Terraform variable application_s3_bucket_name, not imported from this file.
# AWS_S3_BUCKET_NAME=
AWS_S3_PUBLIC_BUCKET=false
AWS_S3_PRESIGNED_URL_EXPIRES_IN=3600
AWS_REKOGNITION_ENABLED=false
AWS_REKOGNITION_KYC_ENABLED=false
AWS_REKOGNITION_KYC_MIN_FACE_QUALITY=50
AWS_REKOGNITION_KYC_MIN_SIMILARITY=40
AWS_REKOGNITION_MIN_CONFIDENCE=50

# Firebase / FCM
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
FCM_CREDENTIALS_BASE64=

# Google OAuth / Maps
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
GOOGLE_MOBILE_CLIENT_IDS=
GOOGLE_MAPS_API_KEY=

# Apple Sign-In
APPLE_CLIENT_ID=
APPLE_CLIENT_IDS=

# FlexPay
FLEXPAY_TOKEN=
FLEX_PAIE_TOKEN=
FLEXPAY_MERCHANT_CODE=
FLEXPAY_CALLBACK_BASE_URL=https://api.zwanga-app.com/api/v1
FLEXPAY_CALLBACK_URL=
FLEXPAY_BOOKING_CALLBACK_URL=
FLEXPAY_TRIP_CALLBACK_URL=
FLEXPAY_SUBSCRIPTION_CALLBACK_URL=
FLEXPAY_WALLET_CALLBACK_URL=
FLEXPAY_DRIVER_PAYOUT_CALLBACK_URL=
FLEXPAY_VERIFY_CALLBACKS=true
FLEXPAY_MOBILE_BASE_URL=
FLEXPAY_PAYMENT_SERVICE_URL=
FLEXPAY_PAYOUT_SERVICE_URL=
FLEXPAY_CARD_BASE_URL=
FLEXPAY_CARD_PAYMENT_PATH=
FLEXPAY_CARD_PAYMENT_URL=
FLEXPAY_CARD_APPROVE_URL=
FLEXPAY_CARD_CANCEL_URL=
FLEXPAY_CARD_DECLINE_URL=
FLEXPAY_CHECK_BASE_URL=
FLEXPAY_CHECK_TRANSACTION_URL=
FLEXPAY_REQUEST_TIMEOUT_MS=30000

# SMS / WhatsApp
DEFAULT_COUNTRY_CODE=+243
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=
INFOBIP_API_KEY=
INFOBIP_BASE_URL=
INFOBIP_WHATSAPP_FROM=
KECCEL_TOKEN=
KECCEL_FROM=
KECCEL_SMS_URL=
KECCEL_OTP_URL_GENERATE=
KECCEL_OTP_URL_VALIDATE=

# Subscriptions / wallet / payments
SUBSCRIPTION_CURRENCY=USD
SUBSCRIPTION_PRICE=10
SUBSCRIPTION_PRO_CURRENCY=USD
SUBSCRIPTION_PRO_PRICE=20
SUBSCRIPTION_PRO_DURATION_DAYS=30
SUBSCRIPTION_DOCUMENT_FUNDING_CURRENCY=USD
SUBSCRIPTION_DOCUMENT_FUNDING_LIMIT=0
TRIAL_PERIOD_DAYS=0
