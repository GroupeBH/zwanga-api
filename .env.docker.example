# App
NODE_ENV=production
TYPEORM_SYNCHRONIZE=false
PORT=5200
API_PREFIX=api/v1
CORS_ORIGINS=https://zwanga-app.com,https://www.zwanga-app.com,http://localhost:3000,http://localhost:5173
FRONTEND_URL=https://zwanga-app.com
TRACKING_PUBLIC_BASE_URL=https://zwanga-app.com
LOG_LEVEL=warn
GPS_LOG_SAMPLE_RATE=0.01

# Maps
GOOGLE_MAPS_API_KEY=
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
# Optional JSON array used to replace the four default Kinshasa weather zones.
WEATHER_ZONES_JSON=
WEATHER_HEAVY_RAIN_THRESHOLD_MM_PER_HOUR=7.6
YANDEX_MAPS_API_KEY=
YANDEX_GEOCODER_URL=https://geocode-maps.yandex.ru/v1/
YANDEX_PLACES_URL=https://search-maps.yandex.ru/v1/
YANDEX_GEOSUGGEST_URL=https://suggest-maps.yandex.ru/v1/suggest

# Database
DOCKER_DATABASE_HOST=postgres
DOCKER_DATABASE_PORT=5432
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres_password
DATABASE_NAME=zwanga_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6380
REDIS_PASSWORD=
REDIS_TLS=false

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_PORT=11434

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=21d

# Initial back-office bootstrap.
# Store ADMIN_BOOTSTRAP_SECRET and ADMIN_BOOTSTRAP_DEFAULT_PASSWORD as secrets
# in production, then rotate/disable them after the first super admin is created.
ADMIN_BOOTSTRAP_SECRET=
ADMIN_BOOTSTRAP_PHONE=+243831919710
ADMIN_BOOTSTRAP_FIRST_NAME=Buania
ADMIN_BOOTSTRAP_LAST_NAME=Superadmin
ADMIN_BOOTSTRAP_DEFAULT_PASSWORD=

# Apple Sign-In
# Comma-separated Apple bundle IDs / services IDs accepted as id_token audiences.
APPLE_CLIENT_IDS=

# Subscriptions
TRIAL_PERIOD_DAYS=7
SUBSCRIPTION_PRO_PRICE=5000
SUBSCRIPTION_PRO_CURRENCY=CDF
SUBSCRIPTION_PRO_DURATION_DAYS=30
SUBSCRIPTION_DOCUMENT_FUNDING_LIMIT=50000
SUBSCRIPTION_DOCUMENT_FUNDING_CURRENCY=CDF

# Trip payments
TRIP_PAYMENT_CURRENCY=CDF
ZWANGA_COMMISSION_RATE=0.05
DRIVER_PAYOUT_MIN_AMOUNT_CDF=1
ZWANGA_LOYALTY_RATE=0.01
ZWANGA_LOYALTY_BASE_REWARD=1
ZWANGA_LOYALTY_POINTS_PER_KM=0.5
ZWANGA_POINTS_CURRENCY=PTS
ZWANGA_POINT_VALUE_CDF=100

# Automatic passenger boarding detection
BOARDING_MINIMUM_RADIUS_METERS=25
BOARDING_MAXIMUM_RADIUS_METERS=60
BOARDING_SAFETY_MARGIN_METERS=10
BOARDING_MAXIMUM_ACCEPTED_ACCURACY_METERS=70
BOARDING_MAXIMUM_LOCATION_AGE_MS=10000
BOARDING_MAXIMUM_TIMESTAMP_DIFFERENCE_MS=5000
BOARDING_DRIVER_MINIMUM_MOVEMENT_METERS=30
BOARDING_PASSENGER_MINIMUM_MOVEMENT_METERS=20
BOARDING_MAXIMUM_HEADING_DIFFERENCE_DEGREES=35
BOARDING_MAXIMUM_SPEED_DIFFERENCE_KMH=10
BOARDING_WINDOW_SIZE=10
BOARDING_MINIMUM_VALID_SAMPLES=7
BOARDING_MINIMUM_CLOSE_SAMPLES_RATIO=0.7
BOARDING_MINIMUM_SHARED_MOVEMENT_DURATION_MS=20000
BOARDING_MINIMUM_SHARED_DISTANCE_METERS=80
BOARDING_SLOW_TRAFFIC_OBSERVATION_DURATION_MS=60000
BOARDING_SLOW_TRAFFIC_MAXIMUM_SPEED_KMH=12
BOARDING_SLOW_TRAFFIC_MINIMUM_SHARED_DISTANCE_METERS=30
BOARDING_MAXIMUM_CONTINUOUS_SEPARATION_DURATION_MS=10000
BOARDING_CANDIDATE_EXPIRATION_MS=600000
BOARDING_CONFIRMATION_SCORE=80
BOARDING_MAXIMUM_PLAUSIBLE_SPEED_METERS_PER_SECOND=70

# FlexPay
FLEXPAY_MERCHANT_CODE=
FLEXPAY_TOKEN=
# Alias supported for existing FlexPay examples/integrations.
FLEX_PAIE_TOKEN=
FLEXPAY_PAYMENT_SERVICE_URL=https://backend.flexpay.cd/api/rest/v1/paymentService
FLEXPAY_PAYOUT_SERVICE_URL=https://backend.flexpay.cd/api/rest/v1/merchantPayOutService
FLEXPAY_MOBILE_BASE_URL=https://backend.flexpay.cd
FLEXPAY_CARD_PAYMENT_URL=https://cardpayment.flexpay.cd/v1.1/pay
FLEXPAY_CARD_BASE_URL=https://cardpayment.flexpay.cd
FLEXPAY_CARD_PAYMENT_PATH=v1.1/pay
FLEXPAY_CHECK_TRANSACTION_URL=https://apicheck.flexpaie.com/api/rest/v1/check/{orderNumber}
FLEXPAY_CHECK_BASE_URL=https://apicheck.flexpaie.com
FLEXPAY_REQUEST_TIMEOUT_MS=30000
FLEXPAY_CALLBACK_URL=
FLEXPAY_CALLBACK_BASE_URL=https://api.zwanga.cd/api/v1
FLEXPAY_SUBSCRIPTION_CALLBACK_URL=
FLEXPAY_BOOKING_CALLBACK_URL=
FLEXPAY_WALLET_CALLBACK_URL=
FLEXPAY_DRIVER_PAYOUT_CALLBACK_URL=
FLEXPAY_VERIFY_CALLBACKS=true
FLEXPAY_CARD_APPROVE_URL=https://zwanga-app.com/subscriptions/payment/success
FLEXPAY_CARD_CANCEL_URL=https://zwanga-app.com/subscriptions/payment/cancel
FLEXPAY_CARD_DECLINE_URL=https://zwanga-app.com/subscriptions/payment/decline
