# App
NODE_ENV=production
TYPEORM_SYNCHRONIZE=false
PORT=5200
API_PREFIX=api/v1
CORS_ORIGINS=https://zwanga-app.com,https://www.zwanga-app.com,http://localhost:3000,http://localhost:5173
FRONTEND_URL=https://zwanga-app.com

# Maps
GOOGLE_MAPS_API_KEY=
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
# Optional JSON array used to replace the four default Kinshasa weather zones.
WEATHER_ZONES_JSON=
WEATHER_HEAVY_RAIN_THRESHOLD_MM_PER_HOUR=7.6
YANDEX_MAPS_API_KEY=
YANDEX_GEOCODER_URL=https://geocode-maps.yandex.ru/v1/
YANDEX_PLACES_URL=https://search-maps.yandex.ru/v1/
YANDEX_GEOSUGGEST_URL=https://suggest-maps.yandex.ru/v1/suggest

# Database
DOCKER_DATABASE_HOST=postgres
DOCKER_DATABASE_PORT=5432
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres_password
DATABASE_NAME=zwanga_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6380
REDIS_PASSWORD=

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_PORT=11434

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=21d

# Apple Sign-In
# Comma-separated Apple bundle IDs / services IDs accepted as id_token audiences.
APPLE_CLIENT_IDS=

# Subscriptions
TRIAL_PERIOD_DAYS=7
SUBSCRIPTION_PRO_PRICE=5000
SUBSCRIPTION_PRO_CURRENCY=CDF
SUBSCRIPTION_PRO_DURATION_DAYS=30
SUBSCRIPTION_DOCUMENT_FUNDING_LIMIT=50000
SUBSCRIPTION_DOCUMENT_FUNDING_CURRENCY=CDF

# Trip payments
TRIP_PAYMENT_CURRENCY=CDF

# FlexPay
FLEXPAY_MERCHANT_CODE=
FLEXPAY_TOKEN=
# Alias supported for existing FlexPay examples/integrations.
FLEX_PAIE_TOKEN=
FLEXPAY_PAYMENT_SERVICE_URL=https://backend.flexpay.cd/api/rest/v1/paymentService
FLEXPAY_MOBILE_BASE_URL=https://backend.flexpay.cd
FLEXPAY_CARD_PAYMENT_URL=https://cardpayment.flexpay.cd/v1.1/pay
FLEXPAY_CARD_BASE_URL=https://cardpayment.flexpay.cd
FLEXPAY_CARD_PAYMENT_PATH=v1.1/pay
FLEXPAY_CHECK_TRANSACTION_URL=https://apicheck.flexpaie.com/api/rest/v1/check/{orderNumber}
FLEXPAY_CHECK_BASE_URL=https://apicheck.flexpaie.com
FLEXPAY_REQUEST_TIMEOUT_MS=30000
FLEXPAY_CALLBACK_URL=
FLEXPAY_CALLBACK_BASE_URL=https://api.zwanga.cd/api/v1
FLEXPAY_SUBSCRIPTION_CALLBACK_URL=
FLEXPAY_BOOKING_CALLBACK_URL=
FLEXPAY_VERIFY_CALLBACKS=true
FLEXPAY_CARD_APPROVE_URL=https://zwanga-app.com/subscriptions/payment/success
FLEXPAY_CARD_CANCEL_URL=https://zwanga-app.com/subscriptions/payment/cancel
FLEXPAY_CARD_DECLINE_URL=https://zwanga-app.com/subscriptions/payment/decline
