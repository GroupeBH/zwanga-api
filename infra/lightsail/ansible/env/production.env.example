NODE_ENV=production
TYPEORM_SYNCHRONIZE=false
HOST=0.0.0.0
PORT=5200
API_PREFIX=api/v1

CORS_ORIGINS=https://app.example.com,https://www.app.example.com
FRONTEND_URL=https://app.example.com

# PostgreSQL is external to this Lightsail instance. You can use DATABASE_URL or the split fields below.
# DATABASE_URL=postgresql://zwanga:password@postgres.example.net:5432/zwanga?sslmode=require
DATABASE_HOST=postgres.example.net
DATABASE_PORT=5432
DATABASE_USER=zwanga
DATABASE_PASSWORD=change-me-strong-postgres-password
DATABASE_NAME=zwanga

# Redis is external to this Lightsail instance. Use REDIS_URL for providers that require TLS, for example rediss://...
# REDIS_URL=rediss://:password@redis.example.net:6379
REDIS_HOST=redis.example.net
REDIS_PORT=6379
REDIS_PASSWORD=change-me-strong-redis-password

JWT_SECRET=change-me-long-random-secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-me-other-long-random-secret
JWT_REFRESH_EXPIRES_IN=21d

# Apple Sign-In
# Comma-separated Apple bundle IDs / services IDs accepted as id_token audiences.
APPLE_CLIENT_IDS=

TRIAL_PERIOD_DAYS=7
SUBSCRIPTION_PRO_PRICE=5000
SUBSCRIPTION_PRO_CURRENCY=CDF
SUBSCRIPTION_PRO_DURATION_DAYS=30
SUBSCRIPTION_DOCUMENT_FUNDING_LIMIT=50000
SUBSCRIPTION_DOCUMENT_FUNDING_CURRENCY=CDF

TRIP_PAYMENT_CURRENCY=CDF
ZWANGA_COMMISSION_RATE=0.05
ZWANGA_LOYALTY_RATE=0.01
ZWANGA_POINTS_CURRENCY=CDF

FLEXPAY_MERCHANT_CODE=
FLEXPAY_TOKEN=
FLEX_PAIE_TOKEN=
FLEXPAY_PAYMENT_SERVICE_URL=https://backend.flexpay.cd/api/rest/v1/paymentService
FLEXPAY_PAYOUT_SERVICE_URL=https://backend.flexpay.cd/api/rest/v1/merchantPayOutService
FLEXPAY_MOBILE_BASE_URL=https://backend.flexpay.cd
FLEXPAY_CARD_PAYMENT_URL=https://cardpayment.flexpay.cd/v1.1/pay
FLEXPAY_CARD_BASE_URL=https://cardpayment.flexpay.cd
FLEXPAY_CARD_PAYMENT_PATH=v1.1/pay
FLEXPAY_CHECK_TRANSACTION_URL=https://apicheck.flexpaie.com/api/rest/v1/check/{orderNumber}
FLEXPAY_CHECK_BASE_URL=https://apicheck.flexpaie.com
FLEXPAY_REQUEST_TIMEOUT_MS=30000
FLEXPAY_CALLBACK_URL=
FLEXPAY_CALLBACK_BASE_URL=https://api.example.com/api/v1
FLEXPAY_SUBSCRIPTION_CALLBACK_URL=
FLEXPAY_BOOKING_CALLBACK_URL=
FLEXPAY_WALLET_CALLBACK_URL=
FLEXPAY_DRIVER_PAYOUT_CALLBACK_URL=
FLEXPAY_VERIFY_CALLBACKS=true
FLEXPAY_CARD_APPROVE_URL=https://app.example.com/subscriptions/payment/success
FLEXPAY_CARD_CANCEL_URL=https://app.example.com/subscriptions/payment/cancel
FLEXPAY_CARD_DECLINE_URL=https://app.example.com/subscriptions/payment/decline
