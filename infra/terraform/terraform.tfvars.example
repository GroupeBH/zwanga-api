# Copy this file to terraform.tfvars locally, or put the full production
# content in the GitHub secret TFVARS_CONTENT.
# Keep app env vars like DATABASE_URL and REDIS_URL outside Terraform.

project_name = "zwanga"
environment  = "prod"
instance_name = "zwanga-api"

# AWS
aws_region                  = "eu-central-1"
availability_zone           = "eu-central-1a"
secondary_availability_zone = "eu-central-1b"

# Network
vpc_cidr                     = "10.42.0.0/16"
public_subnet_cidr           = "10.42.1.0/24"
secondary_public_subnet_cidr = "10.42.2.0/24"

# Compute
ami_id                     = ""
instance_type              = "t3.micro"
secondary_instance_enabled = true
root_volume_size_gb        = 30
key_name                   = "CHANGE_ME_EXISTING_EC2_KEYPAIR"
admin_cidr                 = "203.0.113.10/32"

# Backward-compatible alternative if you want Terraform to create the key pair.
# ssh_public_key_path = "~/.ssh/zwanga.pub"
# existing_key_name   = "CHANGE_ME_EXISTING_EC2_KEYPAIR"

# Public access
domain_name = "api.example.com"
caddy_email = "ops@example.com"

# Docker image built by GitHub Actions and pulled by Ansible.
app_image_repository = "your-org/zwanga-backend"
app_image_tag        = "latest"
app_port             = 5200
app_healthcheck_path = "/api/v1/health"

# Logs and alerts
log_retention_days    = 14
alarm_email_endpoints = []

# Optional AWS SSM parameters
ssm_secure_parameters = {}
