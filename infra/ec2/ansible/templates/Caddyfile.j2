{% set app_domain = domain | default('') %}
{% set contact_email = caddy_email | default('') %}
{% set upstreams = ['app:' ~ app_port] %}
{% for host in groups['app'] if host != inventory_hostname %}
{% set _ = upstreams.append(hostvars[host].private_ip ~ ':' ~ app_port) %}
{% endfor %}
{
  admin off
{% if contact_email | length > 0 %}
  email {{ contact_email }}
{% endif %}
}

{% if app_domain | length > 0 %}
{{ app_domain }} {
{% else %}
:80 {
{% endif %}
  encode zstd gzip

  @internal_health path /healthz
  respond @internal_health "ok" 200

  header {
    -Server
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "accelerometer=(), ambient-light-sensor=(), autoplay=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
{% if app_domain | length > 0 %}
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
{% endif %}
  }

  reverse_proxy {{ upstreams | join(' ') }} {
    lb_policy round_robin
    lb_retries 2
    lb_try_duration 5s
    lb_try_interval 250ms
    fail_duration 30s
    max_fails 3
    health_uri {{ app_healthcheck_path }}
    health_interval 30s
    health_timeout 5s
    unhealthy_status 5xx

    transport http {
      dial_timeout 5s
      response_header_timeout 30s
    }

    header_up X-Forwarded-Proto {scheme}
    header_up X-Forwarded-Host {host}
    header_up X-Real-IP {remote_host}
  }
}
