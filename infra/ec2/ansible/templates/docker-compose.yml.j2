services:
  app:
    image: "{{ app_image_repository }}:{{ app_image_tag | default('latest') }}"
    container_name: zwanga-api
    restart: {{ docker_restart_policy | default('unless-stopped') }}
    security_opt:
      - no-new-privileges:true
    environment:
      NODE_ENV: production
      HOST: 0.0.0.0
      PORT: "{{ app_port }}"
      TYPEORM_SYNCHRONIZE: "false"
    env_file:
      - ./.env
    ports:
      - "{{ private_ip }}:{{ app_port }}:{{ app_port }}"
    volumes:
      - uploads_data:/app/uploads
    logging:
      driver: awslogs
      options:
        awslogs-region: "{{ cloudwatch_region }}"
        awslogs-group: "/{{ cloudwatch_instance_name }}/app"
        awslogs-stream: "app-{{ inventory_hostname }}"
        awslogs-create-group: "false"
    healthcheck:
      test: ["CMD", "node", "-e", "require('http').get('http://127.0.0.1:{{ app_port }}{{ app_healthcheck_path }}', (r) => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 45s
    networks:
      - web

  caddy:
    image: caddy:2.8-alpine
    container_name: caddy
    restart: {{ docker_restart_policy | default('unless-stopped') }}
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
    read_only: true
    tmpfs:
      - /tmp
    depends_on:
      app:
        condition: service_healthy
    ports:
      - "80:80"
      - "443:443"
      - "443:443/udp"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config
    logging:
      driver: awslogs
      options:
        awslogs-region: "{{ cloudwatch_region }}"
        awslogs-group: "/{{ cloudwatch_instance_name }}/caddy"
        awslogs-stream: "caddy-{{ inventory_hostname }}"
        awslogs-create-group: "false"
    networks:
      - web

networks:
  web:
    driver: bridge

volumes:
  uploads_data:
  caddy_data:
  caddy_config:
