#cloud-config
hostname: ${hostname}
manage_etc_hosts: true
package_update: true
packages:
  - python3
  - python3-apt
  - rsync
runcmd:
  - [ systemctl, enable, --now, ssh ]
  - [ sh, -lc, "snap list amazon-ssm-agent >/dev/null 2>&1 || snap install amazon-ssm-agent --classic" ]
  - [ sh, -lc, "systemctl enable --now snap.amazon-ssm-agent.amazon-ssm-agent.service || true" ]
