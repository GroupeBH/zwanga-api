# App
NODE_ENV=development
HOST=0.0.0.0
PORT=5200
API_PREFIX=api/v1
TYPEORM_SYNCHRONIZE=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:5200
TRACKING_PUBLIC_BASE_URL=http://localhost:3000/trips

# Production logging: keep warn in ECS to control CloudWatch costs.
LOG_LEVEL=debug
GPS_LOG_SAMPLE_RATE=0.01

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/zwanga_db?sslmode=disable

# Redis / Valkey
REDIS_URL=redis://localhost:6379
REDIS_TLS=false

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=21d

# Initial back-office bootstrap.
# Store ADMIN_BOOTSTRAP_SECRET and ADMIN_BOOTSTRAP_DEFAULT_PASSWORD as secrets
# in production, then rotate/disable them after the first super admin is created.
ADMIN_BOOTSTRAP_SECRET=
ADMIN_BOOTSTRAP_PHONE=+243831919710
ADMIN_BOOTSTRAP_FIRST_NAME=Buania
ADMIN_BOOTSTRAP_LAST_NAME=Superadmin
ADMIN_BOOTSTRAP_DEFAULT_PASSWORD=

# AWS runtime
AWS_REGION=eu-west-1
AWS_S3_BUCKET_NAME=
AWS_REKOGNITION_ENABLED=false
AWS_REKOGNITION_KYC_ENABLED=false

# Maps and weather
GOOGLE_MAPS_API_KEY=
YANDEX_MAPS_API_KEY=
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# Payments
FLEXPAY_TOKEN=
FLEX_PAIE_TOKEN=
FLEXPAY_MERCHANT_CODE=
FLEXPAY_CALLBACK_BASE_URL=http://localhost:5200/api/v1
FLEXPAY_BOOKING_CALLBACK_URL=
FLEXPAY_TRIP_CALLBACK_URL=
FLEXPAY_SUBSCRIPTION_CALLBACK_URL=
FLEXPAY_WALLET_CALLBACK_URL=
FLEXPAY_DRIVER_PAYOUT_CALLBACK_URL=
FLEXPAY_VERIFY_CALLBACKS=true

# Points / wallet
TRIP_PAYMENT_CURRENCY=CDF
ZWANGA_COMMISSION_RATE=0.05
DRIVER_PAYOUT_MIN_AMOUNT_CDF=1
ZWANGA_POINTS_CURRENCY=POINTS
ZWANGA_POINT_VALUE=100
ZWANGA_POINT_VALUE_CURRENCY=CDF
ZWANGA_LOYALTY_RATE=0.01
ZWANGA_LOYALTY_POINTS_PER_KM=1
ZWANGA_LOYALTY_MIN_REWARD=1
ZWANGA_LOYALTY_BASE_REWARD=5

# Parrainage (jetons retirables, separes du portefeuille promotionnel)
REFERRAL_REWARD_RATE=0.05
REFERRAL_HOLD_DAYS=7
REFERRAL_REWARD_WINDOW_MONTHS=12
REFERRAL_MIN_WITHDRAWAL_TOKENS=50
REFERRAL_TOKENS_CURRENCY=PTS
REFERRAL_PAYOUT_CURRENCY=CDF
REFERRAL_MONEY_PER_TOKEN_CDF=100
REFERRAL_SHARE_BASE_URL=https://zwanga.app/register
FLEXPAY_REFERRAL_PAYOUT_CALLBACK_URL=
REFERRAL_ATTRIBUTION_DAYS=30

# ChottuLink - generation serveur des liens de parrainage
# Cle REST secrete (c_api_...), a ne jamais exposer dans l'application.
CHOTTULINK_REST_API_KEY=
CHOTTULINK_API_URL=https://api2.chottulink.com/chotuCore/pa/v1/create-link
CHOTTULINK_DOMAIN=
CHOTTULINK_LINK_REFRESH_DAYS=330
