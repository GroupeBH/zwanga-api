# App
NODE_ENV=development
HOST=0.0.0.0
PORT=5200
API_PREFIX=api/v1
TYPEORM_SYNCHRONIZE=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:5200
TRACKING_PUBLIC_BASE_URL=http://localhost:3000/trips

# Production logging: keep warn in ECS to control CloudWatch costs.
LOG_LEVEL=debug
GPS_LOG_SAMPLE_RATE=0.01

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/zwanga_db?sslmode=disable

# Redis / Valkey
REDIS_URL=redis://localhost:6379
REDIS_TLS=false

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=21d

# AWS runtime
AWS_REGION=eu-west-1
AWS_S3_BUCKET_NAME=
AWS_REKOGNITION_ENABLED=false
AWS_REKOGNITION_KYC_ENABLED=false

# Maps and weather
GOOGLE_MAPS_API_KEY=
YANDEX_MAPS_API_KEY=
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# Payments
FLEXPAY_TOKEN=
FLEX_PAIE_TOKEN=
FLEXPAY_MERCHANT_CODE=
FLEXPAY_CALLBACK_BASE_URL=http://localhost:5200/api/v1
FLEXPAY_BOOKING_CALLBACK_URL=
FLEXPAY_TRIP_CALLBACK_URL=
FLEXPAY_SUBSCRIPTION_CALLBACK_URL=
FLEXPAY_WALLET_CALLBACK_URL=
FLEXPAY_DRIVER_PAYOUT_CALLBACK_URL=
FLEXPAY_VERIFY_CALLBACKS=true

# Points / wallet
TRIP_PAYMENT_CURRENCY=CDF
ZWANGA_COMMISSION_RATE=0.10
ZWANGA_POINTS_CURRENCY=POINTS
ZWANGA_POINT_VALUE=1
ZWANGA_POINT_VALUE_CURRENCY=CDF
ZWANGA_LOYALTY_RATE=0.01
ZWANGA_LOYALTY_POINTS_PER_KM=1
ZWANGA_LOYALTY_MIN_REWARD=1
ZWANGA_LOYALTY_BASE_REWARD=5
