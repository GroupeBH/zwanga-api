# Preparation only: keep the module disabled until migrations and ECS injection
# have been verified. Never commit a completed copy containing real secrets.
STORE_MANAGEMENT_ENABLED=false
STORE_SYNC_ENABLED=false
STORE_RETENTION_MONTHS=24
STORE_REVIEW_REPLIES_ENABLED=false
STORE_GOOGLE_TEMPORARY_EDITS_ENABLED=false
STORE_APPLE_SALES_REPORTS_ENABLED=false
STORE_SMTP_ENABLED=false

# ECS supplies temporary AWS credentials through its task role.
# Do not add AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY or AWS_SESSION_TOKEN here.
STORE_GOOGLE_AUTH_MODE=aws_wif
STORE_GOOGLE_PACKAGE_NAME=com.zwanga
STORE_GOOGLE_CLIENT_EMAIL=zwanga-play-admin@zwanga-512110.iam.gserviceaccount.com
STORE_GOOGLE_WIF_AUDIENCE=//iam.googleapis.com/projects/243495792368/locations/global/workloadIdentityPools/zwanga-aws-prod/providers/ecs-fargate
# Copy the reporting bucket name from Play Console, without gs:// or a path.
STORE_GOOGLE_REPORTS_BUCKET=pubsite_prod_7262768137520374026
STORE_GOOGLE_INSTALL_DIMENSIONS=country

# Supply these from the approved production secrets, never from the browser.
STORE_APPLE_APP_ID=6756211830
STORE_APPLE_ISSUER_ID=
STORE_APPLE_KEY_ID=
STORE_APPLE_PRIVATE_KEY=

# This file intentionally does not enable Mobile Operations or push campaigns.
